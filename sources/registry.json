  {
    "id": "S3",
    "title": "小山的搜課與排課方案產生（orb.ts）",
    "url": "https://raw.githubusercontent.com/Hunter20041004/campusward-nccu/5d0a4637d66392a3155a4f7a80b7b9eaebfc5b49/apps/web/src/ai/orb.ts",
